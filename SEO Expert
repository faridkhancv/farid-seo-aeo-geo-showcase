const CATS = {
  onpage:{label:'On-Page', color:'#2C7A66'},
  technical:{label:'Technical', color:'#B54B36'},
  offpage:{label:'Off-Page', color:'#CE8A2E'},
  local:{label:'Local', color:'#3B6FA0'},
  advanced:{label:'Advanced GEO/AEO', color:'#7A5AA8'}
};
const PR_COLOR = {H:'var(--rust)', M:'var(--amber)'};

// hero counter
const counterEl = document.getElementById('heroCount');
let cur = 0;
const target = DATA.length;
const step = Math.max(1, Math.round(target/60));
const timer = setInterval(()=>{
  cur += step;
  if(cur >= target){ cur = target; clearInterval(timer); }
  counterEl.innerHTML = cur + '<small>/ ' + target + '</small>';
}, 18);

// category tally bars
const tally = document.getElementById('catTally');
Object.keys(CATS).forEach(k=>{
  const count = DATA.filter(d=>d.c===k).length;
  const pct = Math.round((count/DATA.length)*100);
  const row = document.createElement('div');
  row.className='cat-tally-row';
  row.innerHTML = `<span>${CATS[k].label}</span><span class="cat-tally-bar"><i style="--w:${pct/100}; background:${CATS[k].color}"></i></span><span>${count}</span>`;
  tally.appendChild(row);
});

// tabs
const tabsEl = document.getElementById('tabs');
let activeCat = 'all';
function renderTabs(){
  const allBtn = tabEl('all', `All ${DATA.length}`);
  tabsEl.appendChild(allBtn);
  Object.keys(CATS).forEach(k=>{
    const count = DATA.filter(d=>d.c===k).length;
    tabsEl.appendChild(tabEl(k, `${CATS[k].label} ${count}`));
  });
}
function tabEl(key, label){
  const b = document.createElement('button');
  b.className = 'tab' + (key===activeCat?' active':'');
  b.textContent = label;
  b.onclick = ()=>{ activeCat = key; document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active')); b.classList.add('active'); render(); };
  return b;
}
renderTabs();

// search
const searchInput = document.getElementById('searchInput');
searchInput.addEventListener('input', render);

const grid = document.getElementById('grid');
const resultCount = document.getElementById('resultCount');

function render(){
  const q = searchInput.value.trim().toLowerCase();
  let items = DATA.filter(d => activeCat==='all' || d.c===activeCat);
  if(q){
    items = items.filter(d =>
      d.t.toLowerCase().includes(q) ||
      d.p.toLowerCase().includes(q) ||
      d.f.toLowerCase().includes(q) ||
      d.tools.join(' ').toLowerCase().includes(q)
    );
  }
  resultCount.textContent = `Showing ${items.length} of ${DATA.length} logged issues`;
  grid.innerHTML = '';
  if(items.length===0){
    grid.innerHTML = `<div class="empty-state">No matching entries in the log — try a different term.</div>`;
    return;
  }
  items.forEach(d=>{
    const card = document.createElement('article');
    card.className='ticket';
    card.style.setProperty('--pr-color', PR_COLOR[d.pr] || CATS[d.c].color);
    card.innerHTML = `
      <div class="ticket-top">
        <span class="ticket-id mono">ISSUE #${String(d.n).padStart(3,'0')} · ${CATS[d.c].label}</span>
        <span class="pr-badge" style="--pr-color:${PR_COLOR[d.pr] || CATS[d.c].color}">${d.pr==='H'?'High priority':'Medium priority'}</span>
      </div>
      <h3>${d.t}</h3>
      <div class="row"><span class="lbl">Problem</span>${d.p}</div>
      <div class="row"><span class="lbl">Fix applied</span>${d.f}</div>
      <ul class="impact-list">${d.imp.map(i=>`<li>${i}</li>`).join('')}</ul>
      <div class="tools">${d.tools.map(t=>`<span class="chip">${t}</span>`).join('')}</div>
    `;
    grid.appendChild(card);
  });
}
render();
</script>
</body>
