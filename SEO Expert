<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Farid — SEO Specialist | Full-Site Audit Log</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,500;9..144,600;9..144,700&family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#101817;
    --ink-2:#182322;
    --ink-line: rgba(243,241,233,0.14);
    --paper:#EEF1EC;
    --paper-2:#E4E8E0;
    --card:#FBFCF9;
    --text:#16211E;
    --muted:#5C6B65;
    --teal:#2C7A66;
    --teal-deep:#1F5B4C;
    --amber:#CE8A2E;
    --rust:#B54B36;
    --line: rgba(22,33,30,0.12);
    --radius: 3px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--text);
    font-family:'Public Sans', sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto;}
    *{animation-duration:0.01ms !important; transition-duration:0.01ms !important;}
  }
  a{color:inherit;}
  .mono{font-family:'IBM Plex Mono', monospace;}
  .wrap{max-width:1180px; margin:0 auto; padding:0 32px;}

  /* ---------- NAV ---------- */
  .nav{
    position:sticky; top:0; z-index:50;
    background:rgba(16,24,23,0.92);
    backdrop-filter: blur(8px);
    border-bottom:1px solid var(--ink-line);
    color:#F3F1E9;
  }
  .nav .wrap{display:flex; align-items:center; justify-content:space-between; height:60px;}
  .nav-brand{font-family:'IBM Plex Mono'; font-size:13px; letter-spacing:0.06em; display:flex; align-items:center; gap:10px;}
  .nav-brand .dot{width:7px;height:7px;border-radius:50%;background:var(--teal); box-shadow:0 0 0 3px rgba(44,122,102,0.25);}
  .nav-links{display:flex; gap:28px; font-size:13px; font-family:'IBM Plex Mono'; letter-spacing:0.02em;}
  .nav-links a{text-decoration:none; color:#B9C2BC; transition:color .2s;}
  .nav-links a:hover{color:#F3F1E9;}

  /* ---------- HERO ---------- */
  .hero{
    background:
      radial-gradient(900px 420px at 82% -10%, rgba(44,122,102,0.35), transparent 60%),
      var(--ink);
    color:#F3F1E9;
    padding:96px 0 64px;
    position:relative;
    overflow:hidden;
    border-bottom:1px solid var(--ink-line);
  }
  .hero::after{
    content:"";
    position:absolute; inset:0;
    background-image: linear-gradient(rgba(243,241,233,0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(243,241,233,0.035) 1px, transparent 1px);
    background-size:42px 42px;
    pointer-events:none;
    mask-image: linear-gradient(to bottom, black, transparent 85%);
  }
  .hero-inner{position:relative; z-index:1;}
  .eyebrow{
    font-family:'IBM Plex Mono'; font-size:12.5px; letter-spacing:0.14em; text-transform:uppercase;
    color:#8FBFAF; display:flex; align-items:center; gap:10px; margin-bottom:22px;
  }
  .eyebrow .rule{width:34px; height:1px; background:#8FBFAF; opacity:0.6;}
  .hero h1{
    font-family:'Fraunces', serif;
    font-weight:600;
    font-size:clamp(38px, 6vw, 74px);
    line-height:1.04;
    letter-spacing:-0.01em;
    margin:0 0 22px;
    max-width:920px;
  }
  .hero h1 em{
    font-style:italic;
    font-weight:500;
    color:#9FD8C4;
  }
  .hero p.lede{
    font-size:18px; line-height:1.65; color:#C7CEC8; max-width:600px; margin:0 0 44px;
  }
  .hero p.lede b{color:#F3F1E9; font-weight:600;}

  .scan-console{
    display:grid;
    grid-template-columns: 1.3fr 1fr;
    gap:1px;
    background:var(--ink-line);
    border:1px solid var(--ink-line);
    max-width:900px;
  }
  .scan-console > div{background:var(--ink-2); padding:24px 26px;}
  .scan-label{font-family:'IBM Plex Mono'; font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:#7E8B85; margin-bottom:10px;}
  .scan-count{font-family:'IBM Plex Mono'; font-size:44px; font-weight:600; color:#F3F1E9; line-height:1;}
  .scan-count small{font-size:16px; color:#8FBFAF; font-weight:500; margin-left:6px;}
  .scan-sub{margin-top:10px; font-size:13px; color:#8A968F;}
  .cat-tally{display:flex; flex-direction:column; gap:9px; justify-content:center;}
  .cat-tally-row{display:flex; align-items:center; justify-content:space-between; font-family:'IBM Plex Mono'; font-size:12.5px; color:#B9C2BC;}
  .cat-tally-row span:last-child{color:#8FBFAF;}
  .cat-tally-bar{flex:1; height:3px; background:rgba(255,255,255,0.08); margin:0 10px; position:relative; overflow:hidden;}
  .cat-tally-bar i{position:absolute; inset:0; background:var(--teal); transform-origin:left; transform:scaleX(0); animation:grow 1.1s ease forwards;}
  @keyframes grow{to{transform:scaleX(var(--w));}}

  /* ---------- INTRO STRIP ---------- */
  .intro-strip{
    background:var(--paper-2); border-bottom:1px solid var(--line);
    padding:20px 0;
  }
  .intro-strip .wrap{
    display:flex; gap:40px; align-items:center; flex-wrap:wrap;
    font-family:'IBM Plex Mono'; font-size:12px; letter-spacing:0.02em; color:var(--muted);
  }
  .intro-strip strong{color:var(--text); font-weight:600;}

  /* ---------- FILTER BAR ---------- */
  .filter-bar{
    position:sticky; top:60px; z-index:40;
    background:rgba(238,241,236,0.94);
    backdrop-filter:blur(6px);
    border-bottom:1px solid var(--line);
    padding:16px 0;
  }
  .filter-row{display:flex; gap:10px; flex-wrap:wrap; align-items:center; justify-content:space-between;}
  .tabs{display:flex; gap:8px; flex-wrap:wrap;}
  .tab{
    font-family:'IBM Plex Mono'; font-size:12px; letter-spacing:0.02em;
    padding:8px 14px; border:1px solid var(--line); background:var(--card);
    border-radius:999px; cursor:pointer; color:var(--muted); white-space:nowrap;
    transition:all .15s;
  }
  .tab:hover{border-color:var(--teal); color:var(--teal-deep);}
  .tab.active{background:var(--ink); color:#F3F1E9; border-color:var(--ink);}
  .search-box{
    display:flex; align-items:center; gap:8px;
    border:1px solid var(--line); background:var(--card);
    border-radius:999px; padding:8px 14px; min-width:220px;
  }
  .search-box:focus-within{border-color:var(--teal);}
  .search-box input{
    border:none; outline:none; background:transparent; font-family:'IBM Plex Mono';
    font-size:12.5px; color:var(--text); width:100%;
  }
  .search-box input::placeholder{color:#95A199;}
  .search-box svg{flex-shrink:0; opacity:0.55;}

  /* ---------- SECTION HEADERS ---------- */
  .section-head{padding:56px 0 22px;}
  .section-head .num{font-family:'IBM Plex Mono'; font-size:12px; color:var(--teal-deep); letter-spacing:0.1em;}
  .section-head h2{font-family:'Fraunces'; font-weight:600; font-size:clamp(26px,3vw,36px); margin:8px 0 6px;}
  .section-head p{color:var(--muted); font-size:14.5px; max-width:560px; margin:0;}

  /* ---------- GRID / TICKET CARDS ---------- */
  .grid{
    display:grid; grid-template-columns:repeat(3, 1fr); gap:18px;
    padding-bottom:20px;
  }
  @media (max-width:960px){ .grid{grid-template-columns:repeat(2,1fr);} }
  @media (max-width:640px){ .grid{grid-template-columns:1fr;} }

  .ticket{
    background:var(--card);
    border:1px solid var(--line);
    border-radius:var(--radius);
    padding:20px 20px 18px;
    position:relative;
    display:flex; flex-direction:column; gap:12px;
    transition:transform .18s ease, box-shadow .18s ease, border-color .18s ease;
  }
  .ticket::before{
    content:"";
    position:absolute; left:0; right:0; top:0; height:3px;
    background:var(--pr-color, var(--teal));
  }
  .ticket::after{
    content:"";
    position:absolute; left:16px; top:-1px;
    width:9px; height:9px; border-radius:50%;
    background:var(--paper);
    border:1px solid var(--line);
  }
  .ticket:hover{
    transform:translateY(-3px);
    box-shadow:0 14px 28px -18px rgba(16,24,23,0.35);
    border-color:rgba(22,33,30,0.22);
  }
  .ticket-top{display:flex; align-items:center; justify-content:space-between;}
  .ticket-id{font-family:'IBM Plex Mono'; font-size:11.5px; color:var(--muted); letter-spacing:0.04em;}
  .pr-badge{
    font-family:'IBM Plex Mono'; font-size:10px; letter-spacing:0.08em; text-transform:uppercase;
    padding:3px 8px; border-radius:999px; color:#fff; background:var(--pr-color, var(--teal));
  }
  .ticket h3{font-family:'Fraunces'; font-weight:600; font-size:18.5px; margin:0; line-height:1.25;}
  .ticket .row{font-size:13px; line-height:1.55; color:var(--text);}
  .ticket .row .lbl{font-family:'IBM Plex Mono'; font-size:10px; letter-spacing:0.08em; text-transform:uppercase; color:var(--muted); display:block; margin-bottom:3px;}
  .impact-list{list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:4px;}
  .impact-list li{font-size:12.5px; color:var(--teal-deep); display:flex; gap:6px; align-items:flex-start;}
  .impact-list li::before{content:"✓"; font-family:'IBM Plex Mono'; font-size:11px; color:var(--teal); margin-top:1px;}
  .tools{display:flex; flex-wrap:wrap; gap:6px; margin-top:auto; padding-top:8px; border-top:1px dashed var(--line);}
  .chip{font-family:'IBM Plex Mono'; font-size:10.5px; color:var(--muted); background:var(--paper-2); border-radius:3px; padding:3px 7px;}

  .empty-state{
    grid-column:1/-1; text-align:center; padding:80px 20px; color:var(--muted);
    font-family:'IBM Plex Mono'; font-size:13px;
  }

  /* ---------- FOOTER / SIGN-OFF ---------- */
  .signoff{
    background:var(--ink); color:#F3F1E9; margin-top:70px; padding:80px 0 40px;
    border-top:1px solid var(--ink-line);
  }
  .signoff-inner{display:grid; grid-template-columns:1.2fr 1fr; gap:60px; align-items:end;}
  @media (max-width:800px){ .signoff-inner{grid-template-columns:1fr; gap:40px;} }
  .stamp{
    display:inline-flex; align-items:center; gap:10px;
    border:1.5px solid #6FAE9A; color:#8FBFAF;
    font-family:'IBM Plex Mono'; font-size:11.5px; letter-spacing:0.12em; text-transform:uppercase;
    padding:8px 14px; border-radius:999px; margin-bottom:26px; transform:rotate(-1.5deg);
  }
  .stamp .dot{width:6px; height:6px; border-radius:50%; background:#8FBFAF;}
  .signoff h2{font-family:'Fraunces'; font-weight:600; font-size:clamp(28px,4vw,44px); line-height:1.1; margin:0 0 20px; max-width:520px;}
  .signoff p{color:#B9C2BC; font-size:15px; line-height:1.6; max-width:460px; margin:0 0 28px;}
  .btn-row{display:flex; gap:14px; flex-wrap:wrap;}
  .btn{
    font-family:'IBM Plex Mono'; font-size:13px; letter-spacing:0.02em; text-decoration:none;
    padding:13px 22px; border-radius:3px; display:inline-block; transition:all .15s;
  }
  .btn-primary{background:var(--teal); color:#0E1614; font-weight:600;}
  .btn-primary:hover{background:#379983;}
  .btn-ghost{border:1px solid rgba(243,241,233,0.3); color:#F3F1E9;}
  .btn-ghost:hover{border-color:#F3F1E9;}
  .signoff-meta{font-family:'IBM Plex Mono'; font-size:12px; color:#7E8B85; line-height:2;}
  .signoff-meta strong{color:#C7CEC8; font-weight:500;}
  .signoff-bottom{
    margin-top:70px; padding-top:22px; border-top:1px solid var(--ink-line);
    display:flex; justify-content:space-between; flex-wrap:wrap; gap:10px;
    font-family:'IBM Plex Mono'; font-size:11px; color:#68766F;
  }

  ::selection{background:#2C7A66; color:#fff;}
  :focus-visible{outline:2px solid var(--teal); outline-offset:2px;}
</style>
</head>
