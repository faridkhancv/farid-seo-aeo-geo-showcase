{n:14,c:'onpage',pr:'M',t:'Weak Anchor Text',p:'Internal links used generic anchors like \u201cClick Here\u201d or \u201cRead More.\u201d',f:'Replaced generic anchors with descriptive, keyword-relevant text.',imp:['Improved topical relevance','Better internal SEO signals','Enhanced navigation'],tools:['WordPress','Ahrefs']},
{n:15,c:'onpage',pr:'M',t:'Poor Heading Structure',p:'Heading tags were used inconsistently, ignoring semantic hierarchy.',f:'Organised headings using a clean H1 \u2192 H2 \u2192 H3 \u2192 H4 structure.',imp:['Better readability','Improved crawlability','Clear content organisation'],tools:['Screaming Frog']},
